# ===== PRODUCTION ENV — copy to .env and fill in real secrets =====
APP_NAME=NOW — non-veg on wheel
ENV=production
DEBUG=false
# generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=__CHANGE_ME__strong_random_min_32_chars__
API_V1_PREFIX=/api/v1

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ----- Database (kept internal to the compose network) -----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=luxe
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=luxe
DATABASE_URL=postgresql+asyncpg://luxe:__CHANGE_ME__@db:5432/luxe

REDIS_URL=redis://redis:6379/0
WEB_CONCURRENCY=4

# ----- Payments (India) -----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

GOOGLE_MAPS_API_KEY=
FCM_CREDENTIALS_JSON=
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=

S3_ENDPOINT=
S3_BUCKET=luxe-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en
TIMEZONE=Asia/Kolkata
