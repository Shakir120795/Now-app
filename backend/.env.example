# ---- App ----
APP_NAME=Luxe Commerce
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-prod
API_V1_PREFIX=/api/v1

# ---- Auth ----
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---- Database ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=luxe
POSTGRES_PASSWORD=luxe
POSTGRES_DB=luxe
# Async URL used by the app; Alembic uses the sync psycopg URL derived from these.
DATABASE_URL=postgresql+asyncpg://luxe:luxe@db:5432/luxe

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Payments (India-first) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# ---- Google ----
GOOGLE_MAPS_API_KEY=

# ---- Firebase (push) ----
FCM_CREDENTIALS_JSON=

# ---- SMS (OTP) ----
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=

# ---- Object storage ----
S3_ENDPOINT=
S3_BUCKET=luxe-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# ---- Locale ----
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en
TIMEZONE=Asia/Kolkata
